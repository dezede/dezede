# Anubis now sits between Traefik and nginx, so X-Forwarded-For arrives with
# two internal hops (real client, then Anubis's own address) instead of one.
# Without this, nginx's realip module (non-recursive by default) stops one hop
# too early and logs Anubis's address as the client for every request.
real_ip_recursive on;

# Extra rate-limit zone for Django traffic outside the API and the admin
# (see django.include.template and django_public_rules.include.template
# in this directory, which override the docker-compose-django defaults).
limit_conn_zone $subnet zone=django_public_conn:1m;
limit_req_zone $subnet zone=django_public_req:1m rate=${DJANGO_PUBLIC_LIMIT_REQ_RATE};
