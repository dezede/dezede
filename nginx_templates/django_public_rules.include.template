# Copy of docker-compose-django/nginx/templates/django_rules.include.template but with different limit_conn/limit_req.

proxy_pass http://django:8000;
proxy_set_header Host $http_host;
proxy_redirect off;
proxy_connect_timeout 2s;
proxy_read_timeout ${PROXY_READ_TIMEOUT};
# 1.1 is needed to replace the default 1.0, otherwise `proxy_request_buffering off` is ignored.
# See http://nginx.org/en/docs/http/ngx_http_proxy_module.html#proxy_request_buffering
proxy_http_version 1.1;
proxy_request_buffering off;
proxy_buffering off;

# Parameters to avoid DDOS attacks on gunicorn
limit_conn django_public_conn ${DJANGO_PUBLIC_LIMIT_CONN};
limit_req zone=django_public_req burst=${DJANGO_PUBLIC_LIMIT_REQ_BURST} delay=${DJANGO_PUBLIC_LIMIT_REQ_DELAY};
